DATABASE_URL=postgresql://schoolerp:schoolerp@127.0.0.1:5434/schoolerp?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Expo app reads this from the repo root .env or apps/mobile/.env.
# Android emulator: http://10.0.2.2:4000/api
# Physical device: http://<lan-ip>:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Razorpay key id is public. Keep the secret and webhook secret out of git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Leave empty to keep WhatsApp and SMS fail-closed.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_API_URL=
SMS_API_TOKEN=
